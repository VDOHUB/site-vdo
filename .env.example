# Copie para .env.local e preencha. Nunca versione .env.local (ja ignorado pelo .gitignore).

# URL do VDO Club (menu Acessar e rodape)
NEXT_PUBLIC_VDOCLUB_URL=
# URL da pagina do Facebook (omitido quando vazio)
NEXT_PUBLIC_FACEBOOK_URL=

# Supabase (Project Settings > API). Local: saida de `npx supabase@latest status`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave de servico: ignora o RLS. So no servidor (nunca NEXT_PUBLIC_), nunca versionar.
SUPABASE_SERVICE_ROLE_KEY=

# Leads do formulario de contato: e-mail que recebe o aviso e chave do Resend.
LEADS_NOTIFY_EMAIL=
RESEND_API_KEY=
